# Copy to .env and fill in values. Never commit .env.

# Origins allowed to call the API (CORS). Comma-separated.
ALLOWED_ORIGINS=https://arifinoid.web.id,http://localhost:3000

# Optional LLM generation (OpenAI-compatible chat completions endpoint).
# When unset, the service returns retrieved sources only (retrieval-only mode).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-3.5-turbo

# Bind address for uvicorn.
HOST=127.0.0.1
PORT=8080
